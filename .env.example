# ==========================================
# CloudATS — Environment Variables Template
# ==========================================

# 1. AWS IAM Access Credentials (Needs S3, STS, Rekognition, Textract permissions)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=eu-north-1

# 2. S3 Bucket Name for Resumes
AWS_S3_BUCKET_NAME=your_s3_bucket_name_here

# 3. Optional SES Verified Sender Email (for candidate email confirmations)
AWS_SES_SENDER_EMAIL=your_verified_email@domain.com

# 4. Optional STS Session Token (for AWS Learner/Academy Lab accounts)
AWS_SESSION_TOKEN=

# 5. Recruiter Dashboard Passcode
RECRUITER_PASSCODE=cloudats2026

# 6. Server Port (Default: 5000)
PORT=5000
